-- Delta-sync bookkeeping (device-local — NEVER synced, never part of a delta, base or uploaded
-- snapshot, except that a full send copies ks_v2_edge's rows into its edge tables; see
-- docs/sync-architecture.md "Local Bookkeeping (schema version 3)").
--
-- sync_outbox        every local change to a synced row, in order, appended by the capture
--                    triggers below. pk is the row's primary key (feeds/articles/tags/folders: id,
--                    global_settings: key, feed_tags: feed_id); pk2 is feed_tags' tag_id (NULL for
--                    every other table). heavy = 1 when the delta must carry an article's body.
-- sync_capture       a single row (id = 1): whether changes are recorded at all (only while a
--                    cloud provider is connected), and whether a full send is due.
-- sync_merging       holds a row only inside a merge transaction (inserted first, deleted just
--                    before COMMIT), so a merge never records what it writes.
-- sync_applied       cloud files already merged (this device's own included).
-- sync_cursor        per device, the highest delta seq up to which everything has been merged.
-- ks_search_pending  articles whose search_text must be recomputed after a merge.
-- ks_search_awaiting_body
--                    articles (by id) a merge inserted with no body — from a light row, whose body
--                    another file carries — kept out of the search index until a body arrives, so
--                    they are never indexed with '' (FtsManager.indexMissing). The daily rebuild
--                    indexes them anyway and clears the table.
-- ks_feed_folder_raw per feed, its raw folder assignment — folder_id and folder_updated_at as the
--                    winning version wrote them, whether or not that folder is alive here. It is the
--                    source of truth: feeds.folder_id / folder_updated_at are a cache derived from it
--                    (ks_feed_folder_resolved below), and a send carries the raw value
--                    (DeltaExportSql). Every feed has exactly one row: ks_feed_folder_raw_init
--                    creates it with the feed, every local folder write (feeds.updateFolder,
--                    updateFolderAndSortOrder) updates it, and the merge records the winning version
--                    into it (MergeSql, ranked raw against raw). A row's folder_id is NULL or names a
--                    folder row that exists here (alive or soft-deleted): a local write passes
--                    through feeds' FOREIGN KEY first, the merge records a reference to a folder it
--                    does not hold as NULL, and folder rows are never physically deleted (the
--                    v2->v3 re-key moves the references first). No FOREIGN KEY of its own: the
--                    merge's v2->v3 reconciliation rewrites folder ids in a downloaded pre-delta
--                    copy, whose own copy of this table it cannot see. Device-local data, kept
--                    across joining and disconnect.
-- ks_feed_folder_resolved
--                    (view) the one definition of a feed's resolved folder: the raw folder_id when
--                    that folder exists and is alive (deleted_at IS NULL), else NULL, with the raw
--                    stamp. The ks_feed_folder_resolve_* triggers write it into feeds whenever a raw
--                    row changes or a folder's liveness changes — in every transaction, the sync
--                    merge's included — so feeds.folder_id never disagrees with it after a statement.
-- ks_id_remap        the tag/folder id re-key the v2->v3 migration ran (TagFolderIdRekey): kind
--                    ('tag' / 'folder'), the row's old random id and its new name-derived one, so
--                    SettingsRepository can rewrite the same ids in local_settings.json (lastFilter,
--                    collapsedFolderIds, expandedTagIds) once at startup, and MergeSql can reconcile
--                    pre-upgrade rows that were renamed before the migration. Kept indefinitely;
--                    populated only by that migration; empty on every fresh database.
-- ks_v2_edge         the identity edges of tags and folders: kind ('tag' / 'folder'), a pre-upgrade
--                    (v2) id and a row id the row carrying it was re-keyed to. Rows connected by these
--                    edges (through a shared v2_id or a shared row id) are one identity. A grow-only
--                    set: written by the v2->v3 re-key (TagFolderIdRekey) and by every merge (MergeSql:
--                    the cloud file's edge tables and the v2_id of its and main's rows), carried by
--                    full sends and bases (folder_v2_edges / tag_v2_edges), never deleted. Unlike
--                    sync_applied it is NOT cleared on joining or on disconnect: an edge is a fact about
--                    two ids, not about the connection or the files merged in a generation. No
--                    constraint beyond the primary key: a merge must only be able to violate a FOREIGN
--                    KEY through main's own rows (MergeFailureClassifier).
--
-- The capture triggers fire AFTER INSERT / AFTER UPDATE on the six synced tables, guarded by
-- sync_capture.enabled and the absence of a sync_merging row. An UPDATE is recorded only when a
-- synced column actually changed, so a refresh that rewrites an unchanged row records nothing:
-- - feeds: every column but updated_at (a refresh rewrites it every cycle), created_at, and
--   folder_id / folder_updated_at — those are resolved from ks_feed_folder_raw, and a send carries
--   the raw value, so a change of the raw row is recorded instead (as the feed's own entry, by
--   ks_capture_feed_folder_raw_update), and a re-resolution alone, which changes nothing a send
--   carries, records nothing;
-- - articles: a body column change (content, summary, title, url, author, published_at,
--   thumbnail_url, or the body's stamp body_updated_at) is recorded with heavy = 1, a read/star/deletion change alone with heavy = 0,
--   and cached_at only when its day changes; updated_at and search_text are ignored;
-- - tags, folders, feed_tags, global_settings: every column.
-- No row of a synced table is ever physically deleted (every delete is a tombstone), so there are
-- no DELETE triggers.
--
-- Keep the column lists in step with 2.sqm (which creates the same objects on an upgraded DB) and
-- with the synced tables: SchemaTest compares a created schema with a migrated one.

CREATE TABLE sync_outbox (
    seq   INTEGER PRIMARY KEY AUTOINCREMENT,
    tbl   TEXT    NOT NULL,
    pk    TEXT    NOT NULL,
    pk2   TEXT,
    heavy INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE sync_capture (
    id           INTEGER PRIMARY KEY CHECK (id = 1),
    enabled      INTEGER NOT NULL DEFAULT 0,
    full_pending INTEGER NOT NULL DEFAULT 0
);

INSERT INTO sync_capture (id, enabled, full_pending) VALUES (1, 0, 0);

CREATE TABLE sync_merging (
    flag INTEGER
);

CREATE TABLE sync_applied (
    name TEXT NOT NULL PRIMARY KEY
);

CREATE TABLE sync_cursor (
    device TEXT    NOT NULL PRIMARY KEY,
    seq    INTEGER NOT NULL
);

CREATE TABLE ks_search_pending (
    rowid INTEGER NOT NULL PRIMARY KEY
);

CREATE TABLE ks_search_awaiting_body (
    id TEXT NOT NULL PRIMARY KEY
);

CREATE TABLE ks_feed_folder_raw (
    feed_id           TEXT NOT NULL PRIMARY KEY,
    folder_updated_at INTEGER,
    folder_id         TEXT
);

CREATE VIEW ks_feed_folder_resolved AS
SELECT r.feed_id AS feed_id,
    CASE WHEN EXISTS (SELECT 1 FROM folders f WHERE f.id = r.folder_id AND f.deleted_at IS NULL)
        THEN r.folder_id END AS folder_id,
    r.folder_updated_at AS folder_updated_at
FROM ks_feed_folder_raw r;

CREATE TABLE ks_id_remap (
    kind   TEXT NOT NULL,
    old_id TEXT NOT NULL,
    new_id TEXT NOT NULL,
    PRIMARY KEY (kind, old_id)
);

CREATE TABLE ks_v2_edge (
    kind  TEXT NOT NULL,
    v2_id TEXT NOT NULL,
    id    TEXT NOT NULL,
    PRIMARY KEY (kind, v2_id, id)
);

CREATE TRIGGER ks_capture_feeds_insert AFTER INSERT ON feeds
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('feeds', new.id);
END;

CREATE TRIGGER ks_capture_feeds_update AFTER UPDATE ON feeds
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.id IS NOT new.id
        OR old.url IS NOT new.url
        OR old.site_url IS NOT new.site_url
        OR old.title IS NOT new.title
        OR old.description IS NOT new.description
        OR old.favicon_url IS NOT new.favicon_url
        OR old.custom_title IS NOT new.custom_title
        OR old.deleted_at IS NOT new.deleted_at
        OR old.sort_order IS NOT new.sort_order
        OR old.sort_order_updated_at IS NOT new.sort_order_updated_at
        OR old.custom_title_updated_at IS NOT new.custom_title_updated_at
        OR old.deleted_updated_at IS NOT new.deleted_updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('feeds', new.id);
END;

CREATE TRIGGER ks_capture_feed_folder_raw_update AFTER UPDATE ON ks_feed_folder_raw
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.feed_id IS NOT new.feed_id
        OR old.folder_id IS NOT new.folder_id
        OR old.folder_updated_at IS NOT new.folder_updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('feeds', new.feed_id);
END;

CREATE TRIGGER ks_capture_articles_insert AFTER INSERT ON articles
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk, heavy) VALUES ('articles', new.id, 1);
END;

CREATE TRIGGER ks_capture_articles_update AFTER UPDATE ON articles
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.content IS NOT new.content
        OR old.summary IS NOT new.summary
        OR old.title IS NOT new.title
        OR old.url IS NOT new.url
        OR old.author IS NOT new.author
        OR old.published_at IS NOT new.published_at
        OR old.thumbnail_url IS NOT new.thumbnail_url
        OR old.body_updated_at IS NOT new.body_updated_at
        OR old.is_read IS NOT new.is_read
        OR old.read_at IS NOT new.read_at
        OR old.is_starred IS NOT new.is_starred
        OR old.starred_at IS NOT new.starred_at
        OR old.deleted_at IS NOT new.deleted_at
        OR old.deleted_updated_at IS NOT new.deleted_updated_at
        OR old.cached_at / 86400000 IS NOT new.cached_at / 86400000)
BEGIN
    INSERT INTO sync_outbox (tbl, pk, heavy) VALUES ('articles', new.id,
        CASE WHEN old.content IS NOT new.content
            OR old.summary IS NOT new.summary
            OR old.title IS NOT new.title
            OR old.url IS NOT new.url
            OR old.author IS NOT new.author
            OR old.published_at IS NOT new.published_at
            OR old.thumbnail_url IS NOT new.thumbnail_url
            OR old.body_updated_at IS NOT new.body_updated_at
        THEN 1 ELSE 0 END);
END;

CREATE TRIGGER ks_capture_tags_insert AFTER INSERT ON tags
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('tags', new.id);
END;

CREATE TRIGGER ks_capture_tags_update AFTER UPDATE ON tags
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.id IS NOT new.id
        OR old.name IS NOT new.name
        OR old.color IS NOT new.color
        OR old.sort_order IS NOT new.sort_order
        OR old.deleted_at IS NOT new.deleted_at
        OR old.updated_at IS NOT new.updated_at
        OR old.created_at IS NOT new.created_at
        OR old.name_updated_at IS NOT new.name_updated_at
        OR old.color_updated_at IS NOT new.color_updated_at
        OR old.sort_order_updated_at IS NOT new.sort_order_updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('tags', new.id);
END;

CREATE TRIGGER ks_capture_folders_insert AFTER INSERT ON folders
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('folders', new.id);
END;

CREATE TRIGGER ks_capture_folders_update AFTER UPDATE ON folders
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.id IS NOT new.id
        OR old.name IS NOT new.name
        OR old.sort_order IS NOT new.sort_order
        OR old.deleted_at IS NOT new.deleted_at
        OR old.updated_at IS NOT new.updated_at
        OR old.created_at IS NOT new.created_at
        OR old.name_updated_at IS NOT new.name_updated_at
        OR old.sort_order_updated_at IS NOT new.sort_order_updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('folders', new.id);
END;

CREATE TRIGGER ks_capture_feed_tags_insert AFTER INSERT ON feed_tags
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk, pk2) VALUES ('feed_tags', new.feed_id, new.tag_id);
END;

CREATE TRIGGER ks_capture_feed_tags_update AFTER UPDATE ON feed_tags
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.feed_id IS NOT new.feed_id
        OR old.tag_id IS NOT new.tag_id
        OR old.deleted_at IS NOT new.deleted_at
        OR old.updated_at IS NOT new.updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk, pk2) VALUES ('feed_tags', new.feed_id, new.tag_id);
END;

CREATE TRIGGER ks_capture_global_settings_insert AFTER INSERT ON global_settings
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('global_settings', new.key);
END;

CREATE TRIGGER ks_capture_global_settings_update AFTER UPDATE ON global_settings
WHEN (SELECT enabled FROM sync_capture WHERE id = 1) = 1 AND NOT EXISTS (SELECT 1 FROM sync_merging)
    AND (old.key IS NOT new.key
        OR old.value IS NOT new.value
        OR old.updated_at IS NOT new.updated_at)
BEGIN
    INSERT INTO sync_outbox (tbl, pk) VALUES ('global_settings', new.key);
END;

-- A feed's raw folder row is created with the feed (a feed inserted with no folder starts with NULL /
-- NULL). Not a capture trigger: it runs whether or not capture is on, inside a merge too.
CREATE TRIGGER ks_feed_folder_raw_init AFTER INSERT ON feeds
BEGIN
    INSERT INTO ks_feed_folder_raw (feed_id, folder_updated_at, folder_id)
    VALUES (new.id, new.folder_updated_at, new.folder_id);
END;

-- The resolution: feeds.folder_id / folder_updated_at take ks_feed_folder_resolved's value whenever
-- a raw row is written (one feed) or a folder becomes alive or deleted (the feeds whose raw row names
-- it). A folder row's insertion needs none — no raw row can name a folder before it exists — and no
-- folder row is physically deleted while a raw row names it. The value is always NULL or an alive,
-- existing folder, so it never violates feeds' FOREIGN KEY.
CREATE TRIGGER ks_feed_folder_resolve_raw_insert AFTER INSERT ON ks_feed_folder_raw
BEGIN
    UPDATE feeds SET
        folder_id = (SELECT v.folder_id FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id),
        folder_updated_at = (SELECT v.folder_updated_at FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id)
    WHERE id = new.feed_id
        AND EXISTS (SELECT 1 FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id
            AND (v.folder_id IS NOT feeds.folder_id OR v.folder_updated_at IS NOT feeds.folder_updated_at));
END;

CREATE TRIGGER ks_feed_folder_resolve_raw_update AFTER UPDATE ON ks_feed_folder_raw
BEGIN
    UPDATE feeds SET
        folder_id = (SELECT v.folder_id FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id),
        folder_updated_at = (SELECT v.folder_updated_at FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id)
    WHERE id = new.feed_id
        AND EXISTS (SELECT 1 FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id
            AND (v.folder_id IS NOT feeds.folder_id OR v.folder_updated_at IS NOT feeds.folder_updated_at));
END;

CREATE TRIGGER ks_feed_folder_resolve_folder AFTER UPDATE OF deleted_at ON folders
WHEN (old.deleted_at IS NULL) IS NOT (new.deleted_at IS NULL)
BEGIN
    UPDATE feeds SET
        folder_id = (SELECT v.folder_id FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id),
        folder_updated_at = (SELECT v.folder_updated_at FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id)
    WHERE id IN (SELECT r.feed_id FROM ks_feed_folder_raw r WHERE r.folder_id = new.id)
        AND EXISTS (SELECT 1 FROM ks_feed_folder_resolved v WHERE v.feed_id = feeds.id
            AND (v.folder_id IS NOT feeds.folder_id OR v.folder_updated_at IS NOT feeds.folder_updated_at));
END;

captureState:
SELECT enabled, full_pending FROM sync_capture WHERE id = 1;

setCaptureEnabled:
UPDATE sync_capture SET enabled = ? WHERE id = 1;

outboxAll:
SELECT * FROM sync_outbox ORDER BY seq;

clearOutbox:
DELETE FROM sync_outbox;

beginMerging:
INSERT INTO sync_merging (flag) VALUES (1);

endMerging:
DELETE FROM sync_merging;

feedFolderRawAll:
SELECT feed_id, folder_updated_at, folder_id FROM ks_feed_folder_raw ORDER BY feed_id;

idRemapAll:
SELECT kind, old_id, new_id FROM ks_id_remap;

insertIdRemap:
INSERT OR REPLACE INTO ks_id_remap (kind, old_id, new_id) VALUES (?, ?, ?);

clearIdRemap:
DELETE FROM ks_id_remap;

searchPendingAll:
SELECT rowid FROM ks_search_pending ORDER BY rowid;

-- Joining a generation: recording on, a full send due (domain/SyncRepository).
setCapture:
UPDATE sync_capture SET enabled = :enabled, full_pending = :fullPending WHERE id = 1;

clearFullPending:
UPDATE sync_capture SET full_pending = 0 WHERE id = 1;

-- A committed send: the outbox entries it covered (seq <= its high-water mark S).
deleteOutboxUpTo:
DELETE FROM sync_outbox WHERE seq <= ?;

outboxNonEmpty:
SELECT EXISTS (SELECT 1 FROM sync_outbox);

appliedAll:
SELECT name FROM sync_applied;

insertApplied:
INSERT OR IGNORE INTO sync_applied (name) VALUES (?);

deleteApplied:
DELETE FROM sync_applied WHERE name = ?;

clearApplied:
DELETE FROM sync_applied;

cursorAll:
SELECT device, seq FROM sync_cursor;

-- A cursor only moves forward.
upsertCursor:
INSERT INTO sync_cursor (device, seq) VALUES (:device, :seq)
ON CONFLICT(device) DO UPDATE SET seq = MAX(seq, excluded.seq);

clearCursors:
DELETE FROM sync_cursor;
