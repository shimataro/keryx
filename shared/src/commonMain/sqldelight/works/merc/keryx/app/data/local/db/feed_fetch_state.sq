-- A feed's fetch state on this device (device-local — NEVER synced): the validators of the last
-- response (etag / last_modified, sent back as a conditional request), the count of consecutive
-- failed fetches and the last failure's raw text. Another device's validators would make this
-- device send a conditional request for content it never fetched, and an error belongs to the
-- device that saw it, so none of this leaves the device (see docs/db-schema.md).
--
-- A row is created on the first fetch that has something to record; a feed without one is treated
-- as "never fetched, no errors" — readers LEFT JOIN or default a missing row. None of the writes
-- below touches `feeds`, so they never move its sync stamps.
--
-- last_error doubles as the 410 Gone marker (FEED_ERROR_REASON_GONE, written by markGone): a 410
-- deliberately leaves error_count alone (it is permanent, not a retry candidate), so the marker is
-- the only thing that keeps the feed list flagging the feed. Cleared by resetErrorCount once the
-- feed fetches successfully again.
--
-- Every write below resolves its feed id through ks_id_remap, as the writes in feeds.sq do (see the
-- note there): a refresh holds the feed id across its network I/O, and a re-key in the meantime must
-- not make its fetch state land on a feed id that no longer has a row (the FOREIGN KEY would fail).

CREATE TABLE feed_fetch_state (
    feed_id       TEXT    NOT NULL PRIMARY KEY REFERENCES feeds(id),
    etag          TEXT,
    last_modified TEXT,
    error_count   INTEGER NOT NULL DEFAULT 0,
    last_error    TEXT
);

-- The validators belong to the URL they were fetched from. Whatever changes a feed's url — a sync
-- merge taking another device's url, the identity step giving the canonical feed the other feed's url,
-- a permanent redirect — leaves the stored etag / last_modified describing the old url, and sending
-- them to the new one could be answered 304 for content this device never fetched there. So a url
-- change drops them (the next fetch is unconditional). A refresh stores the validators of its own
-- response after its url write, so a redirect's own validators survive. Not a capture trigger: the
-- fetch state is device-local and never recorded.
CREATE TRIGGER ks_fetch_state_validators_url_change AFTER UPDATE ON feeds
WHEN old.url IS NOT new.url
BEGIN
    UPDATE feed_fetch_state SET etag = NULL, last_modified = NULL
    WHERE feed_id = new.id AND (etag IS NOT NULL OR last_modified IS NOT NULL);
END;

getByFeedId:
SELECT * FROM feed_fetch_state WHERE feed_id = ?;

getAll:
SELECT * FROM feed_fetch_state;

-- The values a subscribe writes over the feed at :url (its content, favicon and the validators
-- describing that content), read in one statement so the content and the validators always come
-- from the same committed state — a refresh writes both in one transaction.
storedValuesByUrl:
SELECT f.id, f.site_url, f.title, f.description, f.favicon_url, s.etag, s.last_modified
FROM feeds f
LEFT JOIN feed_fetch_state s ON s.feed_id = f.id
WHERE f.url = ?;

-- The feeds the feed list flags: a failed last fetch (error_count > 0) or the 410 Gone marker.
watchProblems:
SELECT feed_id, error_count, last_error FROM feed_fetch_state
WHERE error_count > 0 OR last_error = :goneMarker;

-- Writes the validators of the response just stored, leaving the error columns of an existing row
-- alone (a new row starts with no errors).
upsertValidators:
INSERT INTO feed_fetch_state (feed_id, etag, last_modified)
VALUES (COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), :etag, :last_modified)
ON CONFLICT(feed_id) DO UPDATE SET
    etag = excluded.etag,
    last_modified = excluded.last_modified;

incrementErrorCount:
INSERT INTO feed_fetch_state (feed_id, error_count, last_error)
VALUES (COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), 1, :last_error)
ON CONFLICT(feed_id) DO UPDATE SET
    error_count = error_count + 1,
    last_error = excluded.last_error;

-- 410 Gone: records the reason only, deliberately leaving error_count alone (see the header).
markGone:
INSERT INTO feed_fetch_state (feed_id, last_error)
VALUES (COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), :last_error)
ON CONFLICT(feed_id) DO UPDATE SET
    last_error = excluded.last_error;

resetErrorCount:
UPDATE feed_fetch_state SET error_count = 0, last_error = NULL WHERE feed_id = COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id);
