-- Many-to-many between feeds and tags. Tag attach/detach is expressed with the
-- deleted_at soft-delete flag (NULL = currently attached). Timestamp-last-wins.

CREATE TABLE feed_tags (
    feed_id    TEXT    NOT NULL,
    tag_id     TEXT    NOT NULL,
    deleted_at INTEGER,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (feed_id, tag_id),
    FOREIGN KEY (feed_id) REFERENCES feeds(id),
    FOREIGN KEY (tag_id) REFERENCES tags(id)
);

watchTagIdsForFeed:
SELECT tag_id FROM feed_tags WHERE feed_id = ? AND deleted_at IS NULL;

-- The tag id is resolved through ks_id_remap (see articles.sq's watchByTag).
watchFeedIdsForTag:
SELECT feed_id FROM feed_tags
WHERE tag_id = COALESCE((SELECT id FROM tags WHERE id = :tagId), (SELECT new_id FROM ks_id_remap WHERE kind = 'tag' AND old_id = :tagId), :tagId)
    AND deleted_at IS NULL;

watchAllActive:
SELECT feed_id, tag_id FROM feed_tags WHERE deleted_at IS NULL;

-- updated_at is this row's last-write-wins stamp in the sync merge and moves only forward:
-- MAX(now, previous + 1). The merge settles an equal stamp by its tie rule (the cloud side wins),
-- which knows nothing of which write came later, so a write stamped at the value the row already
-- holds would lose to the older value on the next merge. See docs/db-schema.md.
-- :tag_id is resolved like every tag id a write takes (see tags.sq), so an attach/detach issued with
-- the id a merge has since re-keyed lands on the row it became rather than failing tag_id's FOREIGN
-- KEY. :feed_id is resolved the same way, through the feed kind (see feeds.sq).
upsert:
INSERT INTO feed_tags (feed_id, tag_id, deleted_at, updated_at)
VALUES (COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), COALESCE((SELECT id FROM tags WHERE id = :tag_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'tag' AND old_id = :tag_id), :tag_id), :deleted_at, :updated_at)
ON CONFLICT(feed_id, tag_id) DO UPDATE SET
    deleted_at = excluded.deleted_at,
    updated_at = MAX(excluded.updated_at, updated_at + 1);
