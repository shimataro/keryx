-- Articles fetched from feeds. Read / starred state lives here and syncs with a
-- timestamp-last-wins policy (read_at / starred_at). is_read / is_starred are
-- 0/1 (Long). All timestamps are Unix milliseconds.
-- search_text = plain text of content (else summary), HTML tags stripped; feeds articles_fts.
--
-- Soft-deleted via deleted_at (NULL = not deleted). Cache cleanup is the only local originator of
-- a deletion (softDeleteExpired), and it never deletes a starred article; an unstar of a deleted
-- article stamps an undelete (updateStarStatus). `deleted_updated_at` is a field-specific
-- last-wins timestamp for the deletion/undeletion event (like read_at / starred_at, and like
-- feeds.deleted_updated_at), kept separate from the row's `updated_at` so a content refresh /
-- read / star change (which all bump updated_at) can't clobber a deletion during the sync merge.
-- NULL = no delete/undelete event yet. In the merge the star (is_starred by starred_at) and the
-- deletion (deleted_at by deleted_updated_at) are TWO independent last-write-wins groups with no
-- rule across them, so a row can be both starred and deleted (a star from one device, a cleanup
-- from another). Version 2 already wrote such rows (a star older than another device's cleanup)
-- and hid them, since it showed only `deleted_at IS NULL`; migration 2 -> 3 (2.sqm) records each
-- one's star as removed at its deletion, so it stays hidden. Whether an article is shown is decided
-- here, when it is read:
--
--     VISIBLE = (deleted_at IS NULL OR is_starred = 1)
--
-- Every query below that lists, counts or acts on articles as the user sees them uses exactly that
-- predicate (ArticleVisibility.kt holds the same rule for raw SQL and Kotlin;
-- ArticleVisibilityQueriesTest fails on a `deleted_at IS NULL` used alone outside its allow-list).
--
-- body_updated_at is the body's own last-write-wins stamp (content, summary, title, url, author,
-- published_at, thumbnail_url): set when the article is inserted and moved forward only when a
-- body column actually changes, never by a read / star / deletion write — so merely opening an
-- article never makes its older body beat a newer one from another device. updated_at stays the
-- row's generic stamp and is no merge group's key. Nullable only because migration 2 -> 3 adds it
-- (initialized to updated_at there); every write here sets it.

CREATE TABLE articles (
    id            TEXT    NOT NULL PRIMARY KEY,
    feed_id       TEXT    NOT NULL,
    guid          TEXT    NOT NULL,
    url           TEXT    NOT NULL,
    title         TEXT    NOT NULL,
    summary       TEXT,
    content       TEXT,
    author        TEXT,
    published_at  INTEGER,
    thumbnail_url TEXT,
    is_read       INTEGER NOT NULL DEFAULT 0,
    read_at       INTEGER,
    is_starred    INTEGER NOT NULL DEFAULT 0,
    starred_at    INTEGER,
    cached_at     INTEGER NOT NULL,
    search_text   TEXT    NOT NULL DEFAULT '',
    updated_at    INTEGER NOT NULL,
    created_at    INTEGER NOT NULL,
    deleted_at         INTEGER,
    deleted_updated_at INTEGER,
    body_updated_at    INTEGER,
    FOREIGN KEY (feed_id) REFERENCES feeds(id),
    UNIQUE (feed_id, guid)
);

CREATE INDEX idx_articles_feed_id    ON articles(feed_id);
CREATE INDEX idx_articles_is_read    ON articles(is_read);
CREATE INDEX idx_articles_is_starred ON articles(is_starred);
CREATE INDEX idx_articles_published  ON articles(published_at DESC, created_at DESC, id DESC);

-- The five list queries below deliberately project only the eight columns the article list renders
-- (plus created_at, the sort tie-break) instead of `*`. `content` / `summary` / `search_text` hold
-- the whole article body twice over; selecting them here materialised every article's full text on
-- every emission, and these flows re-run on every write to `articles` *or* `feeds`. The body is
-- fetched per selected article by getById instead, and `search_text` has no Kotlin-side reader at
-- all (it exists for FTS5's external content and for MergeSql).
--
-- The column ORDER IS LOAD-BEARING: all five are mapped with ::ArticleListRow, whose parameters are
-- positional. Reordering `title`/`url` (both String) would compile and silently swap them, which is
-- what ArticleRepositoryTest.articleListRowMapsEveryProjectedColumnToItsOwnField guards.
watchAll:
SELECT a.id, a.feed_id, a.title, a.url, a.published_at, a.created_at, a.is_read, a.is_starred
FROM articles a
INNER JOIN feeds f ON f.id = a.feed_id
WHERE f.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1)
ORDER BY a.published_at DESC, a.created_at DESC, a.id DESC;

watchStarred:
SELECT id, feed_id, title, url, published_at, created_at, is_read, is_starred
FROM articles WHERE is_starred = 1 AND (deleted_at IS NULL OR is_starred = 1)
ORDER BY published_at DESC, created_at DESC, id DESC;

watchByFeed:
SELECT id, feed_id, title, url, published_at, created_at, is_read, is_starred
FROM articles WHERE feed_id = COALESCE((SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id) AND (deleted_at IS NULL OR is_starred = 1)
ORDER BY published_at DESC, created_at DESC, id DESC;

-- watchByFeed / watchByTag / watchByFolder resolve the id through ks_id_remap like the writes do (tags.sq /
-- folders.sq), as part of the statement: a sync merge that moves the selected tag or folder onto
-- another id re-runs these queries when it commits, before the selection has followed the move,
-- and the re-run must still show the same list — an empty one in between would drop the
-- new-articles pill's count and the list's scroll position. Only ks_id_remap is consulted, not the
-- feeds / tags / folders table: no live row has an id that is an old_id in ks_id_remap (IdRemapSql drops the
-- entry of an id that names a row again), so "the id unchanged while a row has it" needs no lookup
-- of its own — and a lookup in feeds / tags / folders would re-run this query (and so re-emit the
-- list) on every rename or reorder of a feed, tag or folder, which cannot change the articles listed.
watchByTag:
SELECT a.id, a.feed_id, a.title, a.url, a.published_at, a.created_at, a.is_read, a.is_starred
FROM articles a
INNER JOIN feeds f ON f.id = a.feed_id
INNER JOIN feed_tags ft ON ft.feed_id = f.id
WHERE ft.tag_id = COALESCE((SELECT new_id FROM ks_id_remap WHERE kind = 'tag' AND old_id = :tagId), :tagId)
    AND ft.deleted_at IS NULL AND f.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1)
ORDER BY a.published_at DESC, a.created_at DESC, a.id DESC;

watchByFolder:
SELECT a.id, a.feed_id, a.title, a.url, a.published_at, a.created_at, a.is_read, a.is_starred
FROM articles a
INNER JOIN feeds f ON f.id = a.feed_id
WHERE f.folder_id = COALESCE((SELECT new_id FROM ks_id_remap WHERE kind = 'folder' AND old_id = :folderId), :folderId)
    AND f.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1)
ORDER BY a.published_at DESC, a.created_at DESC, a.id DESC;

getById:
SELECT * FROM articles WHERE id = ?;

-- Batched by-id fetch of list rows (callers chunk the id list to stay under SQLite's bound-parameter
-- limit). Used by search() to load all FTS hits in one query per chunk instead of one getById per
-- hit. Same eight columns, and the same load-bearing order, as the list queries above.
getListRowsByIds:
SELECT id, feed_id, title, url, published_at, created_at, is_read, is_starred
FROM articles WHERE id IN ?;

-- Which of the given ids still have a visible row, and their current read/star flags. Used to
-- revalidate HomeViewModel._pinnedReadStates/_pinnedUnstarredArticles in one query instead of one
-- getById per pin (callers chunk to stay under the bound-parameter limit). The column ORDER IS
-- LOAD-BEARING the same way the list queries' is (see getListRowsByIds above): is_read/is_starred
-- are both INTEGER and adjacent, so a swap would compile and silently pass.
aliveFlagsIn:
SELECT id, is_read, is_starred FROM articles WHERE id IN ? AND (deleted_at IS NULL OR is_starred = 1);

-- Every visible article id belonging to the given feeds. Used to acknowledge a just-subscribed
-- feed's articles in the new-articles pill's baseline (callers chunk to stay under the
-- bound-parameter limit).
idsByFeeds:
SELECT id FROM articles WHERE feed_id IN ? AND (deleted_at IS NULL OR is_starred = 1);

-- The new-articles pill's insertion watermark: the highest rowid currently in the table (0 when
-- empty). maxRowId/idsInsertedAfter tell a genuinely newly inserted article apart from an
-- existing one that merely re-entered a list's query (re-starred, its feed moved into the viewed
-- folder/tag). This relies on the live table's implicit rowid being stable and monotonic:
-- refresh upserts and the sync merge both use INSERT ... ON CONFLICT DO UPDATE (never INSERT OR
-- REPLACE, which would delete and re-insert under a new rowid), rows are only ever soft-deleted
-- (never physically removed, so a freed max rowid can't be reused), and a plain VACUUM (which may
-- renumber an implicit rowid) never runs on the live DB (the full send only reads a VACUUM INTO copy).
-- articles_fts's content_rowid already depends on the same guarantee.
maxRowId:
SELECT COALESCE(MAX(rowid), 0) FROM articles;

-- Which of the given ids belong to rows inserted after the given maxRowId watermark (callers
-- chunk to stay under the bound-parameter limit).
idsInsertedAfter:
SELECT id FROM articles WHERE rowid > ? AND id IN ?;

getByFeedAndGuid:
SELECT * FROM articles WHERE feed_id = ? AND guid = ?;

-- All guids for a feed (including tombstoned rows, matching getByFeedAndGuid's lack of a
-- deleted_at filter). Used by upsertParsed to compute the new-article count with a single
-- query instead of one existence SELECT per parsed article.
getGuidsByFeed:
SELECT guid FROM articles WHERE feed_id = ?;

watchUnreadCount:
SELECT COUNT(*) FROM articles a
INNER JOIN feeds f ON f.id = a.feed_id
WHERE a.is_read = 0 AND f.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1);

watchStarredUnreadCount:
SELECT COUNT(*) FROM articles WHERE is_read = 0 AND is_starred = 1 AND (deleted_at IS NULL OR is_starred = 1);

-- Lightweight change ping: re-emits whenever the `articles` table is mutated (SQLDelight
-- notifies listeners table-wide, so the value need not change to fire). Used only as a signal
-- to re-run FTS search; the count value itself is discarded by the collector.
countArticles:
SELECT COUNT(*) FROM articles;

watchUnreadCountsByFeed:
SELECT feed_id, COUNT(*) AS cnt FROM articles WHERE is_read = 0 AND (deleted_at IS NULL OR is_starred = 1) GROUP BY feed_id;

watchUnreadCountsByTag:
SELECT ft.tag_id, COUNT(*) AS cnt
FROM articles a
INNER JOIN feed_tags ft ON ft.feed_id = a.feed_id
WHERE a.is_read = 0 AND ft.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1)
GROUP BY ft.tag_id;

watchUnreadCountsByFolder:
SELECT f.folder_id, COUNT(*) AS cnt
FROM articles a
INNER JOIN feeds f ON f.id = a.feed_id
WHERE a.is_read = 0 AND f.folder_id IS NOT NULL AND f.deleted_at IS NULL AND (a.deleted_at IS NULL OR a.is_starred = 1)
GROUP BY f.folder_id;

-- body_updated_at: the insert's own time on a new row; on an existing one it moves forward
-- (MAX(now, previous + 1), like the other stamps) only when a body column actually changes, so a
-- refresh that rewrites an unchanged article leaves it where it was. Every SET expression is
-- evaluated against the row as it was, so the comparison sees the old body.
-- :feed_id is resolved through ks_id_remap like every feed id a write takes (see feeds.sq): a refresh
-- holds the feed id across its network I/O, so a re-key that lands meanwhile must not make its
-- articles fail the FOREIGN KEY or form a second (feed_id, guid) key beside the row the re-key
-- already moved; with the id resolved, the conflict target sees the canonical feed's row. The
-- article id itself is left as given: an id a re-key moved away belongs to an article whose
-- (feed_id, guid) key the moved row now has, so such an insert hits the conflict target.
insert:
INSERT INTO articles (
    id, feed_id, guid, url, title, summary, content, author, published_at,
    thumbnail_url, is_read, read_at, is_starred, starred_at, cached_at,
    search_text, updated_at, created_at, body_updated_at
) VALUES (?, COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, :updated_at, ?, :updated_at)
ON CONFLICT(feed_id, guid) DO UPDATE SET
    url = excluded.url,
    title = excluded.title,
    summary = excluded.summary,
    content = excluded.content,
    author = excluded.author,
    published_at = excluded.published_at,
    thumbnail_url = excluded.thumbnail_url,
    cached_at = excluded.cached_at,
    search_text = excluded.search_text,
    updated_at = excluded.updated_at,
    body_updated_at = CASE
        WHEN url IS NOT excluded.url
            OR title IS NOT excluded.title
            OR summary IS NOT excluded.summary
            OR content IS NOT excluded.content
            OR author IS NOT excluded.author
            OR published_at IS NOT excluded.published_at
            OR thumbnail_url IS NOT excluded.thumbnail_url
        THEN MAX(excluded.body_updated_at, COALESCE(body_updated_at, 0) + 1)
        ELSE body_updated_at
    END;

-- As insert, but leaves an article already stored for the feed (tombstoned or not) exactly as it
-- is, adding only the ones not there yet. For a subscribe that kept a refresh's newer feed values
-- (FeedRepository.writePrefetchedSubscription): its own fetch is the older response, so it must not
-- put older bodies back under the refresh's validators. :feed_id is resolved as in insert.
insertIfAbsent:
INSERT INTO articles (
    id, feed_id, guid, url, title, summary, content, author, published_at,
    thumbnail_url, is_read, read_at, is_starred, starred_at, cached_at,
    search_text, updated_at, created_at, body_updated_at
) VALUES (?, COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, :updated_at, ?, :updated_at)
ON CONFLICT(feed_id, guid) DO NOTHING;

-- Only writes when the state actually changes, so re-opening an already-read article neither
-- re-stamps read_at (which would win last-write-wins over another device's later "mark unread" and
-- change the sync snapshot for nothing) nor needs a sync. The affected-row count tells the caller
-- whether anything changed.
--
-- read_at, starred_at and deleted_updated_at move only forward on their row: MAX(now, previous + 1),
-- in every statement below that stamps them. The sync merge settles an equal stamp by its tie rule
-- (decided by value), which knows nothing of which write came later, so a change stamped at the
-- value the row already holds — two changes within one millisecond, or one made right after a merge
-- brought that stamp in — could lose to the older value on the next merge. See docs/db-schema.md.
-- Each stamp is its own merge group's, so each is moved above its own previous value only.
-- None of these touch body_updated_at.
--
-- An article id given to these writes is resolved like a feed id (see feeds.sq), through the article
-- kind of ks_id_remap: a re-key moves an article onto the smallest id of its (feed, guid) key, and a
-- read / star change issued with the id held before the move (the selected article, a queued write)
-- lands on the row it became. 'article' is ID_REMAP_KIND_ARTICLE (TagFolderIdRekey.kt).
updateReadStatus:
UPDATE articles SET is_read = :is_read, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ? WHERE id = COALESCE((SELECT id FROM articles WHERE id = :id), (SELECT new_id FROM ks_id_remap WHERE kind = 'article' AND old_id = :id), :id) AND is_read <> :is_read;

-- Marks a batch of articles read in one statement (callers chunk the id list to stay under
-- SQLite's bound-parameter limit). Used by markArticlesAsRead instead of a per-id UPDATE loop.
-- Guarded like the markAllRead* queries: the ids can come from optimistic in-memory pins that outrun
-- the DB, so a row no longer visible (deleted and not starred) or already read is left alone rather than stamped with a read event
-- (read_at/updated_at) the user never made, which would otherwise ride the next sync.
-- The ids are resolved as a set: a live id matches itself, and a moved one matches the row
-- ks_id_remap maps it to (no live row has an id that is an old_id there). The list is bound twice, so
-- callers chunk it to half the usual size.
updateReadStatusByIds:
UPDATE articles SET is_read = 1, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ? WHERE (id IN :id OR id IN (SELECT new_id FROM ks_id_remap WHERE kind = 'article' AND old_id IN :id)) AND is_read = 0 AND (deleted_at IS NULL OR is_starred = 1);

-- Same no-op guard as updateReadStatus, for starred_at. A star touches only the star group: a starred
-- article is visible whatever its deletion says, so a star made on an article a merge has just
-- deleted — still on screen in the reader — keeps it, here and on every device the star reaches.
-- An unstar of a deleted row also stamps an undelete in the deletion group (deleted_at NULL,
-- deleted_updated_at moved forward like any stamp), so the article the user just unstarred stays on
-- screen until the next cache cleanup deletes it again rather than vanishing under the user. An
-- unstar of a row that is not deleted leaves the deletion group alone.
updateStarStatus:
UPDATE articles SET is_starred = :is_starred,
    starred_at = MAX(:starred_at, COALESCE(starred_at, 0) + 1),
    deleted_updated_at = CASE WHEN :is_starred = 0 AND deleted_at IS NOT NULL
        THEN MAX(:starred_at, COALESCE(deleted_updated_at, 0) + 1)
        ELSE deleted_updated_at END,
    deleted_at = CASE WHEN :is_starred = 0 THEN NULL ELSE deleted_at END,
    updated_at = ?
WHERE id = COALESCE((SELECT id FROM articles WHERE id = :id), (SELECT new_id FROM ks_id_remap WHERE kind = 'article' AND old_id = :id), :id) AND is_starred <> :is_starred;

-- Every markAllRead* query marks only visible articles (deleted_at IS NULL OR is_starred = 1), the
-- rows its list shows. The feed_id EXISTS guard on markAllReadAll/markAllReadByTag keeps this in the same row set as
-- the corresponding plain list query (watchAll/watchByTag, both INNER JOIN feeds ... f.deleted_at
-- IS NULL): otherwise "mark all read" on All Feeds / a tag would also mark read an article
-- belonging to an unsubscribed (soft-deleted) feed, which never appears in that list. Unlike
-- watchAll/watchByTag, markAllReadByFeed/markAllReadByFolder don't need this — a soft-deleted
-- feed can't be the one directly selected, nor carry a folder assignment worth acting on.
-- markAllReadByFeed resolves its feed id (see feeds.sq), and markAllReadByTag / markAllReadByFolder
-- their tag / folder id (see tags.sq / folders.sq), so
-- a mark-all-read queued with the id a merge has since re-keyed marks the list it became.
markAllReadAll:
UPDATE articles SET is_read = 1, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ?
WHERE is_read = 0 AND (deleted_at IS NULL OR is_starred = 1)
  AND EXISTS (SELECT 1 FROM feeds f WHERE f.id = articles.feed_id AND f.deleted_at IS NULL);

markAllReadByFeed:
UPDATE articles SET is_read = 1, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ? WHERE feed_id = COALESCE((SELECT id FROM feeds WHERE id = :feed_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'feed' AND old_id = :feed_id), :feed_id) AND is_read = 0 AND (deleted_at IS NULL OR is_starred = 1);

markAllReadByTag:
UPDATE articles SET is_read = 1, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ?
WHERE is_read = 0 AND (deleted_at IS NULL OR is_starred = 1) AND feed_id IN (
    SELECT ft.feed_id FROM feed_tags ft
    INNER JOIN feeds f ON f.id = ft.feed_id
    WHERE ft.tag_id = COALESCE((SELECT id FROM tags WHERE id = :tag_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'tag' AND old_id = :tag_id), :tag_id) AND ft.deleted_at IS NULL AND f.deleted_at IS NULL
);

markAllReadByFolder:
UPDATE articles SET is_read = 1, read_at = MAX(:read_at, COALESCE(read_at, 0) + 1), updated_at = ?
WHERE is_read = 0 AND (deleted_at IS NULL OR is_starred = 1) AND feed_id IN (
    SELECT id FROM feeds WHERE folder_id = COALESCE((SELECT id FROM folders WHERE id = :folder_id), (SELECT new_id FROM ks_id_remap WHERE kind = 'folder' AND old_id = :folder_id), :folder_id) AND deleted_at IS NULL
);

-- Soft-deletes expired cache entries (stamps deleted_at / deleted_updated_at so the deletion
-- propagates via the sync merge instead of being resurrected from the cloud). Keeps starred
-- articles and the latest 10 alive per feed (the subquery excludes tombstoned rows, so a
-- persisted tombstone can't occupy a protected slot and drop live retention below 10).
-- `deleted_at IS NULL` makes it idempotent (never re-stamps an already-tombstoned row). Its stamp
-- moves above the row's own deleted_updated_at only: the star is a separate merge group.
--
-- The protected set is ranked with ROW_NUMBER() rather than a correlated `... WHERE
-- a2.feed_id = articles.feed_id ORDER BY ... LIMIT 10` subquery, so it is evaluated ONCE for
-- the whole statement instead of re-running (and re-sorting, via a temp B-tree) for every
-- candidate row. Both forms select the same rows: a row eligible for stamping is by definition
-- excluded by this `NOT IN` guard, so no member of the protected set is ever stamped and the
-- set cannot shift while the statement runs — which makes per-row re-evaluation redundant.
softDeleteExpired:
UPDATE articles
SET deleted_at = ?, deleted_updated_at = MAX(:deleted_updated_at, COALESCE(deleted_updated_at, 0) + 1), updated_at = ?
WHERE is_starred = 0
  AND deleted_at IS NULL
  AND cached_at < ?
  AND id NOT IN (
      SELECT id FROM (
          SELECT id, ROW_NUMBER() OVER (
              PARTITION BY feed_id
              ORDER BY published_at DESC, created_at DESC, id DESC
          ) AS rn
          FROM articles
          WHERE deleted_at IS NULL
      )
      WHERE rn <= 10
  );

lastRowId:
SELECT last_insert_rowid();
