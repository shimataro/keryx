-- Tags for organizing feeds. Soft-deleted (deleted_at). Timestamp-last-wins sync.

CREATE TABLE tags (
    id         TEXT    NOT NULL PRIMARY KEY,
    name       TEXT    NOT NULL UNIQUE,
    color      TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    deleted_at INTEGER,
    updated_at INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);

watchAll:
SELECT * FROM tags WHERE deleted_at IS NULL ORDER BY sort_order ASC, name COLLATE NOCASE ASC;

getById:
SELECT * FROM tags WHERE id = ?;

getByName:
SELECT * FROM tags WHERE name = ?;

upsert:
INSERT INTO tags (id, name, color, sort_order, deleted_at, updated_at, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    color = excluded.color,
    sort_order = excluded.sort_order,
    deleted_at = excluded.deleted_at,
    updated_at = excluded.updated_at;

-- Creates the tag named :name, or reactivates the existing one of that name in place (same id,
-- sort_order and created_at kept; a null :color keeps its color). The name conflict is resolved by
-- the statement itself rather than by a lookup before it, so a row of the same name that another
-- writer (a sync merge, a concurrent create) inserted in between is reused instead of failing
-- UNIQUE(name). :id is used only when no row has the name. A reactivation's updated_at is never at or
-- before the row's previous one (see softDelete).
upsertByName:
INSERT INTO tags (id, name, color, sort_order, deleted_at, updated_at, created_at)
VALUES (:id, :name, :color, 0, NULL, :now, :now)
ON CONFLICT(name) DO UPDATE SET
    color = COALESCE(excluded.color, color), deleted_at = NULL, updated_at = MAX(excluded.updated_at, updated_at + 1);

-- updated_at never goes backwards or repeats on a row here: MAX(now, previous + 1), so a delete and a
-- recreation made within the same millisecond still order strictly. The sync merge's last-write-wins
-- compares with a strict ">", so an equal stamp would leave the later event unpropagated — and the
-- recreated row indistinguishable from the one before the delete. See docs/db-schema.md.
softDelete:
UPDATE tags SET deleted_at = ?, updated_at = MAX(?, updated_at + 1) WHERE id = ?;
