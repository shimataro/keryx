-- Global settings (KVS). Synced across devices. Timestamp-last-wins.
-- value is a plain string, not JSON (an int/boolean is encoded via its own toString()). Known keys:
-- read_timeout_seconds, cache_retention_days, article_list_default_unread_only.

CREATE TABLE global_settings (
    key        TEXT    NOT NULL PRIMARY KEY,
    value      TEXT    NOT NULL,
    updated_at INTEGER NOT NULL
);

get:
SELECT value FROM global_settings WHERE key = ?;

watch:
SELECT value FROM global_settings WHERE key = ?;

-- updated_at is this row's last-write-wins stamp in the sync merge and moves only forward:
-- MAX(now, previous + 1). The merge settles an equal stamp by its tie rule (the cloud side wins),
-- which knows nothing of which write came later, so a write stamped at the value the row already
-- holds would lose to the older value on the next merge. See docs/db-schema.md.
upsert:
INSERT INTO global_settings (key, value, updated_at)
VALUES (?, ?, ?)
ON CONFLICT(key) DO UPDATE SET
    value = excluded.value,
    updated_at = MAX(excluded.updated_at, updated_at + 1);
