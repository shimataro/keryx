{
  "permissions": {
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew :composeApp:build:*)",
      "Bash(./gradlew :composeApp:desktopTest:*)",
      "Bash(./gradlew :composeApp:compileKotlinDesktop:*)",
      "Bash(./gradlew :composeApp:compileDesktopMainKotlin:*)",
      "Bash(./gradlew :composeApp:generateCommonMainKeryxDatabaseInterface:*)",
      "Bash(./gradlew :composeApp:generateComposeResClass:*)",
      "Bash(./gradlew :composeApp:tasks:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "WebSearch"
