<?xml version="1.0" encoding="utf-8"?>
<!-- The UI languages the app ships (composeResources values/ = English, values-ja/ = Japanese),
     listed so Android 13+ offers them in the system's per-app language setting. Keep in lockstep
     with the composeResources locales. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ja" />
</locale-config>
