<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo template for the .deb package (injected by the packageDeb finalizer in
  composeApp/build.gradle.kts). GNOME Software / Ubuntu App Center / KDE Discover read this file
  for the license and homepage/links they show — the .deb control file itself has neither field.

  Placeholders substituted at build time:
    @DESKTOP_ID@ — the actual .desktop filename jpackage produced (see the injection task; not
                   hardcoded here because jpackage derives it from linux-package-name + launcher
                   name and this template must not assume that exact casing).
    @VERSION@    — appPackageVersion (numeric MAJOR.MINOR.PATCH, matching the .deb's own Version:).
    @DATE@       — the build date (ISO 8601), for the <release> entry below.
-->
<component type="desktop-application">
  <id>works.merc.keryx</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Keryx</name>
  <summary>A cloud-sync, multi-platform RSS reader</summary>
  <summary xml:lang="ja">クラウド同期・マルチプラットフォーム対応の RSS リーダー</summary>
  <!-- AppStream requires exactly one <description> element; per-language text is carried by
       xml:lang on each <p>, not by repeating <description> (a repeated, localized <description>
       tag fails pedantic appstreamcli validation). -->
  <description>
    <p>
      Keeps your subscriptions in sync across every device through your own cloud storage
      (Dropbox / Google Drive / OneDrive) — no account required.
    </p>
    <p xml:lang="ja">
      お使いのクラウドストレージ（Dropbox / Google Drive / OneDrive）を通じて、複数端末間で
      購読を同期できます。アカウント登録は不要です。
    </p>
  </description>
  <launchable type="desktop-id">@DESKTOP_ID@</launchable>
  <url type="homepage">https://keryx.merc.works</url>
  <url type="bugtracker">https://github.com/shimataro/keryx/issues</url>
  <url type="vcs-browser">https://github.com/shimataro/keryx</url>
  <developer id="works.merc">
    <name>Mercury Works</name>
  </developer>
  <update_contact>keryx_AT_merc.works</update_contact>
  <categories>
    <category>Network</category>
    <category>News</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
