-- Cloud sync metadata (KVS, device-local — NOT synced). Known keys are the
-- core/Constants.kt SYNC_STATE_* values: SYNC_STATE_LAST_SYNCED_AT ("last_synced_at", Unix ms),
-- SYNC_STATE_CLOUD_FILE_REV ("cloud_file_rev" — provider-specific: Dropbox rev / Google Drive
-- version / OneDrive eTag, used for conflict detection), SYNC_STATE_LAST_UPLOADED_DIGEST
-- ("last_uploaded_snapshot_digest").

CREATE TABLE sync_state (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

get:
SELECT value FROM sync_state WHERE key = ?;

upsert:
INSERT INTO sync_state (key, value)
VALUES (?, ?)
ON CONFLICT(key) DO UPDATE SET value = excluded.value;
