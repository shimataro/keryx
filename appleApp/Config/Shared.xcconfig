// Shared build settings for every configuration (Debug and Release alike — signing doesn't
// differ by configuration here). Defaults to ad-hoc signing with no team, which is what CI and a
// fresh checkout build with. A developer's own Local.xcconfig (gitignored — see
// Local.xcconfig.example) overrides DEVELOPMENT_TEAM/CODE_SIGN_STYLE below with their own Apple
// Developer team, which every entitled feature (Keychain access groups, the sandbox) needs to
// actually work on a real device/login session. See docs/setup.md's "Apple targets" for the
// one-time setup.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Sparkle's EdDSA public key (macOS only; Info.plist's SUPublicEDKey). Empty keeps the updater
// switched off: it never starts, so the app makes no update request and the "Check for Updates…"
// item stays disabled. Fill it in for the release build once the release EdDSA key pair exists
// (`generate_keys`); the matching private key lives only in the release CI's secrets.
SPARKLE_PUBLIC_ED_KEY =

#include? "../Local.xcconfig"
