# Copy this file to `local.properties` and fill in your own values.
# `local.properties` is git-ignored and never committed.
#
# Priority (each property is resolved in this order):
#   1. -P<gradleProperty> (Gradle project property, e.g. `./gradlew -PdropboxAppKey=...`)
#   2. Environment variable
#   3. `local.properties` value
#   4. Default (empty string or noted below)
#
# sdk.dir is the one exception: it is read directly by the Android Gradle Plugin (AGP) itself,
# not through the -P/env-var/local.properties chain above. It's required for `./gradlew build`
# to succeed at all (composeApp configures an Android library target), but not for a
# desktop-scoped task like `:composeApp:desktopTest` — see docs/setup.md.
# sdk.dir=/path/to/Android/sdk

# Dropbox OAuth App Key.
#   Gradle property: -PdropboxAppKey=...
#   Environment variable: DROPBOX_APP_KEY
#   Default: (empty)
# Leave empty (or omit the file entirely) to disable Dropbox sync — the
# Dropbox option is then hidden from the Setup / Settings screens.
# See docs/build.md for how to obtain an App Key.
dropbox.app.key=

# Google Drive OAuth Client ID, from the same "Desktop app" OAuth client.
#   Gradle property: -PgoogleDriveClientId=...
#   Environment variable: GOOGLE_DRIVE_CLIENT_ID
#   Default: (empty)
# Leave empty (or omit) to disable Google Drive sync — the Google Drive
# option is then hidden from the Setup / Settings screens.
# See docs/build.md for how to obtain a Client ID.
googledrive.client.id=

# Google Drive OAuth Client Secret.
#   Gradle property: -PgoogleDriveClientSecret=...
#   Environment variable: GOOGLE_DRIVE_CLIENT_SECRET
#   Default: (empty)
# Google's token endpoint requires secret even though the flow uses PKCE.
googledrive.client.secret=

# OneDrive (Microsoft Identity platform) OAuth Client ID, from an Azure
# "Mobile and desktop applications" app registration (public client).
#   Gradle property: -PoneDriveClientId=...
#   Environment variable: ONEDRIVE_CLIENT_ID
#   Default: (empty)
# Leave empty (or omit) to disable OneDrive sync — the OneDrive option is then
# hidden from the Setup / Settings screens. No client secret is required (PKCE
# public client). See docs/build.md for how to obtain a Client ID.
onedrive.client.id=

# GitHub "owner/repo" slug the update checker polls (releases/latest API).
#   Gradle property: -PupdateRepo=...
#   Environment variable: UPDATE_REPO
#   Default: shimataro/keryx
update.repo=
